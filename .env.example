# LinkedIn session cookie (browser devtools -> Application -> Cookies -> linkedin.com)
LI_AT=
# JSESSIONID value without surrounding quotes, e.g. ajax:1234567890
JSESSIONID=
# For long-term without manual token swap, set email/password — app auto-refreshes LI_AT on 502 (single retry; no 2FA handling)
LI_EMAIL=
LI_PASSWORD=
# graphql queryId for profile sections (skills/certs/languages). Rotates; capture from a logged-in profile page.
LI_QUERY_ID=
PORT=3000
